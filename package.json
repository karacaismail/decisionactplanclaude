{
  "name": "decisionactplanclaude",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run check:bundle",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit && node scripts/check-ui.mjs && node scripts/check-css-architecture.mjs",
    "check:css": "node scripts/check-css-architecture.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:bundle:test": "node scripts/check-bundle.mjs --self-test",
    "test": "vitest run",
    "test:unit": "vitest run && npm run check:bundle:test",
    "test:e2e": "PW_PORT=\"${PW_PORT:-${PLAYWRIGHT_PORT:-5179}}\" playwright test",
    "test:e2e:ci": "PW_PORT=\"${PW_PORT:-${PLAYWRIGHT_PORT:-5179}}\" playwright test --project=chromium-320 --project=chromium-1280 --workers=2 && npm run test:teslim:production",
    "test:teslim:production": "npm run build && node scripts/check-bundle.mjs --production-test",
    "ci": "npm run lint && npm run test:unit && npm run test:e2e:ci"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "antd": "^6.7.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
